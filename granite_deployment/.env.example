# aw-aiguard: Granite Guardian (EC2) Environment
#
# This file is read by docker-compose.yml in granite_deployment/.
# The GUARDIAN_API_KEY value here must match gateway/.env.

# API key for the llama.cpp server (--api-key flag).
# Generate a new key with: openssl rand -hex 24
GUARDIAN_API_KEY=your_key_here
