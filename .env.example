# Gateway Proxy Environment Variables
# Copy this file to gateway/.env and fill in the values.

# Target API (the LLM provider you want to proxy through the gateway)
TARGET_API_BASE_URL=https://api.openai.com/v1
TARGET_API_KEY=your-api-key-here

# Gateway listener
PROXY_PORT=9020

# Guardian Model (safety judge endpoint)
GUARDIAN_URL=http://localhost:8080/v1/chat/completions
GUARDIAN_MODEL=granite4.1-guardian
GUARDIAN_API_KEY=
GUARDIAN_THRESHOLD=0.85
LLM_SAFETY_MODE=hard_block
GUARDIAN_TIMEOUT=2.0
GUARDIAN_THINKING_TIMEOUT=30.0

# Central Service (audit, HITL state, BYOC sync, dashboard)
CENTRAL_SERVICE_URL=http://localhost:8000
BYOC_CLOUD_URL=

# Optional: Emergency filter override (set to "true" to block all requests)
EMERGENCY_FILTER_BLOCK_ALL=false
