# aw-aiguard Central Service Environment Variables
# Copy to .env and fill in your values

# Database (Docker: connects to 'postgres' service)
DATABASE_URL=postgresql://aiguard:aiguard_local_dev@localhost:5432/aw_aiguard

# MinIO (Docker: connects to 'minio' service)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aiguard
MINIO_SECRET_KEY=aiguard_local_dev

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Alerts
SLACK_WEBHOOK_URL=

# Email Alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
