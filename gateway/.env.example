# aw-aiguard Gateway Proxy Configuration

# ==========================================
# Target LLM Provider Configuration
# ==========================================

# The API key for the target LLM provider (OpenAI, Anthropic, etc.)
TARGET_API_KEY=your_api_key_here

# The base URL of the target LLM API (e.g., https://api.openai.com/v1)
TARGET_API_BASE_URL=https://api.openai.com/v1

# The local port the proxy will listen on
PROXY_PORT=9020

# ==========================================
# Guardian Configuration (Phase 1.3+)
# ==========================================

# The endpoint of the Central Service (where the model server lives)
GUARDIAN_URL=http://localhost:8000/guardian

# The specific model the Central Service should use for this request
GUARDIAN_MODEL=granite4.1-guardian

# Strategy if the Guardian service is unreachable. 
# Options: 
# - block: Fail-closed. Block all requests if safety cannot be verified. (Max Security)
# - allow: Fail-open. Allow requests to pass through. (Max Availability)
# - warn: Allow but tag as 'unverified' in audit logs and trigger admin alert. (Audit Mode)
# - fallback: Use a local lightweight emergency filter before deciding. (Defense-in-Depth)
GUARDIAN_FAIL_STRATEGY=block

# ==========================================
# PII & Secrets Scanner Configuration (Phase 1.4+)
# ==========================================

# Sequence: 'A' (Guardian first) or 'B' (PII first, default)
SCAN_SEQUENCE=B

# Redaction Mode: 'token' ([SECRET_1]) or 'mask' (AKIA****1234)
SCAN_REDACTION_MODE=token

# ==========================================
# HITL "Pause" Middleware Configuration (Phase 1.5+)
# ==========================================

# Default timeout for HITL requests (in seconds) before auto-denial
HITL_DEFAULT_TIMEOUT=300

# Notification mode: 'silent' (default), 'detailed', or 'summary' (roadmap)
HITL_NOTIFICATION_MODE=silent
