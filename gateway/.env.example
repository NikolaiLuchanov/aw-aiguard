# aw-aiguard Gateway Proxy Configuration

# The API key for the target LLM provider (OpenAI, Anthropic, etc.)
TARGET_API_KEY=your_api_key_here

# The base URL of the target LLM API (e.g., https://api.openai.com/v1)
TARGET_API_BASE_URL=https://api.openai.com/v1

# The local port the proxy will listen on
PROXY_PORT=9020
