# aw-aiguard Gateway Proxy Configuration
#
# This file documents the three independent configuration axes.
# Never conflate them — they target three different services.

# ==========================================
# Axis 1: Target LLM Provider
# The primary LLM the agent talks to (ChatGPT, Gemini, Qwen, etc.)
# ==========================================

# The API key for the target LLM provider
TARGET_API_KEY=your_api_key_here

# The base URL of the target LLM API
# Example: https://api.openai.com/v1 (commercial) or http://localhost:8080/v1 (local llama.cpp)
TARGET_API_BASE_URL=https://api.openai.com/v1

# The local port the proxy will listen on
PROXY_PORT=9020

# ==========================================
# Axis 2: Guardian (Granite Safety Judge)
# Granite 4.1 Guardian via llama.cpp — deployed on EC2 (granite_deployment/)
# GUARDIAN_URL is REQUIRED at startup — no default.
# ==========================================

# Full endpoint to the granite guardian (OpenAI-compatible /v1/chat/completions).
# Dev: http://<ec2-private-ip>:8080/v1/chat/completions
# Prod: http://<ec2-public-ip>:8080/v1/chat/completions
GUARDIAN_URL=

# Model name the guardian server should use
GUARDIAN_MODEL=granite4.1-guardian

# API key for the guardian server (llama.cpp --api-key).
# Empty = no auth header. Must match the --api-key passed to llama.cpp.
GUARDIAN_API_KEY=

# Fail-safe strategy when the guardian is unreachable.
# block: Fail-closed. Block all requests if safety cannot be verified.
# allow: Fail-open. Allow requests to pass through.
# warn: Allow but tag as 'unverified' in audit logs and trigger admin alert.
# fallback: Use a local lightweight emergency filter before deciding.
GUARDIAN_FAIL_STRATEGY=block

# ==========================================
# Axis 3: Central Service (Audit / Dashboard / BYOC)
# The central backend — audit ingestion, admin dashboard, BYOC sync.
# ==========================================

# Base URL for the central service API (not the guardian endpoint).
CENTRAL_SERVICE_URL=http://localhost:8000

# Legacy override for backwards compatibility only — deprecated.
# Use CENTRAL_SERVICE_URL instead. Retired: BYOC_CLOUD_URL
# BYOC_CLOUD_URL=http://localhost:8000

# ==========================================
# PII & Secrets Scanner (Phase 1.4+)
# ==========================================

# Sequence: 'A' (Guardian first) or 'B' (PII first, default)
SCAN_SEQUENCE=B

# Redaction Mode: 'token' ([SECRET_1]) or 'mask' (AKIA****1234)
SCAN_REDACTION_MODE=token

# ==========================================
# HITL "Pause" Middleware (Phase 1.5+)
# ==========================================

# Default timeout for HITL requests (in seconds) before auto-denial
HITL_DEFAULT_TIMEOUT=300

# Notification mode: 'silent' (default), 'detailed', or 'summary'
HITL_NOTIFICATION_MODE=silent
